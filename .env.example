# ==========================================================
# SMARTTRIP - MODELO DE VARIÁVEIS DE AMBIENTE (.env.example)
# Copie este arquivo para .env.local e configure suas chaves.
# NUNCA comite o arquivo .env.local no Git.
# ==========================================================

# ----------------------------------------------------------
# 1. INTELIGÊNCIA ARTIFICIAL (GOOGLE GEMINI)
# ----------------------------------------------------------
# Chave de API obtida em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# URL base da aplicação para auto-referenciamento e redirecionamentos
APP_URL=http://localhost:3000

# ----------------------------------------------------------
# 2. FIREBASE CLIENT SDK (VARIÁVEIS PÚBLICAS DO NAVEGADOR)
# ----------------------------------------------------------
# Obtenha no Firebase Console > Configurações do Projeto > Seus Aplicativos (Web)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ----------------------------------------------------------
# 3. FIREBASE ADMIN SDK (VARIÁVEIS PRIVADAS DE SERVIDOR)
# ----------------------------------------------------------
# ATENÇÃO: Utilizadas EXCLUSIVAMENTE em ambiente de servidor (Node.js / Vercel Secrets).
# NUNCA adicione o prefixo VITE_ a estas variáveis para não vazarem ao cliente.
# Obtenha em: Firebase Console > Configurações do Projeto > Contas de Serviço > Gerar nova chave privada
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
